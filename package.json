{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "postinstall": "prisma generate",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:scan": "bun run scripts/security/secret-scan.ts",
    "security:scan:staged": "bun run scripts/security/secret-scan.ts --staged",
    "security:redact:dryrun": "bun run scripts/security/redact-known-secrets.ts",
    "security:redact:execute": "bun run scripts/security/redact-known-secrets.ts --execute",
    "security:tests": "bun test scripts/security/secret-scan.test.ts src/lib/mtq/__tests__/release-controls.test.ts src/lib/mtq/__tests__/address-book-validation.test.ts",
    "check:no-neon": "bun run scripts/check-no-neon.ts",
    "test": "bun test",
    "test:backtest": "bun run src/lib/mtq/__tests__/historical-backtest.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:backup": "bun run scripts/backup-sqlite.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
