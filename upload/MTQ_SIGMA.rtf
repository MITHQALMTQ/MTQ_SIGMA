\fs44 \cf2 C.1 EIP-712 signed decision scheme\
\pard\intbl\itap2\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Gap in v5.0: v5.0 requires "signed decision records" and "canonical serialization, signature domain separation, nonce or replay protection, expiry, and duplicate-submission handling" but does not specify the scheme.\
Required:\
The decision record must use EIP-712 structured typed data signing with the following schema:\
\pard\intbl\itap2\pardeftab720\partightenfactor0

\f1\fs24 \cf2 \cb8 text
\f0\fs26 \cb1 \

\f1 \cb8 EIP712Domain \{\
  string name;              // "MTQ Sigma MARP"\
  string version;           // "1"\
  uint256 chainId;          // actual chain ID\
  address verifyingContract; // the MTQ contract address\
  bytes32 salt;             // keccak256 of the deployment identifier\
\}\
\
TradeDecision \{\
  bytes32 decisionId;         // unique, keccak256 of the full decision\
  address keeper;             // msg.sender identity\
  bytes32 assetIn;            // keccak256 of the input symbol\
  bytes32 assetOut;           // keccak256 of the output symbol\
  uint256 amountIn;           // native decimals of assetIn\
  uint256 minAmountOut;       // native decimals of assetOut\
  uint256 quoteTimestamp;     // block.timestamp of quote\
  uint256 deadline;           // quote expiry\
  bytes32 costModelVersion;   // keccak256 of the approved cost model\
  bytes32 protectionModelVersion; // keccak256 of the approved protection model\
  bytes32 objectiveVersion;   // keccak256 of the approved J(s) version\
  bytes32 parameterSetHash;   // keccak256 of the parameter set\
  uint256 grossBenefitE18;    // computed off-chain\
  uint256 netBenefitE18;      // computed off-chain\
  uint256 thresholdE18;       // approved threshold\
\}\
\
function executeWithSignature(TradeDecision calldata decision, bytes calldata signature)\
    external\
    nonReentrant\
\{\
    bytes32 digest = _hashTypedDataV4(_hashDecision(decision));\
    require(!usedDecisions[decision.decisionId], "Decision replay");\
    usedDecisions[decision.decisionId] = true;\
    require(block.timestamp <= decision.deadline, "Decision expired");\
    require(ECDSA.recover(digest, signature) == authorizedKeeper[decision.keeper], "Invalid signature");\
    require(_validateParameterSet(decision.parameterSetHash), "Parameter set mismatch");\
    _executeTrade(decision);\
\}\cb1 \

