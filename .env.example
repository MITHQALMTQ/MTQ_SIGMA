# ============================================================
# MTQΣ — Environment Variables (EXAMPLE — safe to commit)
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# ZERO-COST CONSTRAINT: All services below have free tiers that
# require NO credit card. If any service asks for a card during
# signup, STOP and report to COO/PM.
# ============================================================

# === Database (Turso libSQL — free tier, no credit card) ===
# Signup: https://turso.tech — free tier: 9GB, 500M row reads/mo
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Prisma CLI uses DATABASE_URL (must embed auth token as ?auth= for libSQL)
DATABASE_URL=libsql://your-db-your-org.turso.io?auth=your-turso-auth-token-here

# === AI Provider Keys (server-side only, never exposed to client) ===
# Groq: https://console.groq.com — free tier, no card
GROQ_API_KEY=gsk_your_groq_key_here
# Gemini: https://aistudio.google.com — free tier, no card
GEMINI_API_KEY=your_gemini_key_here
# HuggingFace: https://huggingface.co/settings/tokens — free tier, no card
HUGGINGFACE_API_KEY=hf_your_hf_key_here

# === AI Feature Flags (optional, default true) ===
AI_BRIEFING_ENABLED=true
AI_QA_ENABLED=true

# === Deployer Wallet (TESTNET ONLY — HOT WALLET, not governance-grade) ===
# CRITICAL TODO: Rotate this key and transfer contract ownership to a Safe
# multi-sig before any public testnet launch.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_deployer_private_key_here

# === RPC Endpoints (free tier, no credit card) ===
# Alchemy (primary): https://alchemy.com — free tier, no card
ALCHEMY_API_KEY=your_alchemy_api_key_here
# QuickNode (fallback, 1-month trial — DO NOT architect as permanent)
QUICKNODE_API_KEY=your_quicknode_api_key_here

# === Upstash Redis (rate limiting + locks — free tier, no card) ===
# Signup: https://upstash.com — free tier: 500k commands/mo, 256MB, no card
# Optional: if unset, rate limiter falls back to in-memory (dev only)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# === Sentry (error tracking — free tier, no card) ===
# Signup: https://sentry.io — free tier: 50k errors/mo, no card
# SENTRY_DSN — server/edge runtime DSN (no NEXT_PUBLIC_ prefix; never shipped
#              to the browser bundle).
# NEXT_PUBLIC_SENTRY_DSN — client runtime DSN (shipped to browser; this is OK
#                          because the DSN is a public value — Sentry only
#                          accepts events sent with it, no read access).
# SENTRY_ORG + SENTRY_PROJECT — used by `withSentryConfig` at build time to
#                                upload source maps. If unset, the wrapper
#                                silently no-ops (graceful degradation).
# SENTRY_AUTH_TOKEN — only needed in CI for source map upload. NEVER commit.
#                     Set as a GitHub Actions secret, not in .env.local.
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here  # CI only — do NOT commit

# === Tenderly (contract monitoring — free tier, no card) ===
# Signup: https://tenderly.co — free tier, no card
# TENDERLY_WEBHOOK_SECRET — HMAC secret used by /api/webhooks/tenderly to
#                            verify that incoming alerts are genuinely from
#                            Tenderly (and not a forged request). Generate a
#                            32+ char random string and paste the same value
#                            into the Tenderly webhook config UI.
TENDERLY_WEBHOOK_SECRET=your_tenderly_webhook_secret_here

# === Discord/Slack alerts (free webhooks) ===
# Discord: Server Settings → Integrations → Webhooks → New Webhook
# When set, the Tenderly webhook receiver forwards every alert to this URL.
# When unset, alerts are accepted (200 ACK) but not forwarded (silent).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# === Keeper (Koyeb — hot wallet, low-privilege) ===
# Label: HOT WALLET — can only submit weight vectors, cannot mint/redeem/pause
# Rotate regularly. Monitor usage.
KEEPER_PRIVATE_KEY=0xyour_keeper_hot_wallet_private_key_here
KEEPER_ADDRESS=0xyour_keeper_hot_wallet_address_here

# === Environment marker ===
NODE_ENV=development

# === FRED API (Federal Reserve Economic Data — free, no credit card) ===
# Signup: https://fred.stlouisfed.org — free API key, no card
# Used for: VIX, DXY, Treasury yields, CPI, GDP as macro oracle inputs
FRED_API_KEY=your_fred_api_key_here
