generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PilotTrial {
  id        String   @id @default(cuid())
  type      String
  chain     String
  inputAmount  Float
  inputSymbol  String
  outputAmount Float
  outputSymbol String
  gfbIndex     Float
  mtqPrice     Float
  nav          Float
  reserveRatio Float
  lcr          Float
  status       String
  basketJson   String?
  ok           Boolean  @default(true)
  reason       String?
  wallet       String?
  createdAt    DateTime @default(now())
}

model MetricSample {
  id        String   @id @default(cuid())
  gfbIndex  Float
  mtqPrice  Float
  nav       Float
  reserveRatio Float
  lcr       Float
  status    String
  vix       Float
  dxy       Float
  targetGold Float
  bufferState String
  createdAt DateTime @default(now())
}
