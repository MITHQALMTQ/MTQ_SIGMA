# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
# .env.example IS committed — it has dummy values only

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
# Allow the Solidity Foundry test directory (contracts/test/) — needed for
# the LIQ-MGMT test suite and future V3 tests. The blanket `test` rule above
# would otherwise ignore it.
!contracts/test/
!contracts/test/**
prompt

server.log
# Skills directory
/skills/
upload/*.txt
upload/private_key.txt
screenshots/
agent-ctx/

# TASK-5 — Deterministic compute engine output (do not commit; CI uploads as artifact)
weight-vector.json
/weight-vector.json

# TASK-9 — Turso daily backups: large artifacts stay on disk only (CI uploads as artifact + GitHub Release);
# backup MANIFESTS are tracked so SHA-256 fingerprints live in the audit trail
/backups/*
!/backups/BACKUP-MANIFEST-*.md

# TASK 12 — AI-tool persisted-output cache (never commit: may snapshot file
# contents that contain or later contain sensitive material)
tool-results/
# TASK 12 — fresh-keypair output of scripts/generate-new-evm-key.mjs
.fresh-evm-keypair-DO-NOT-COMMIT.txt
lib/forge-std/
contracts/lib/forge-std/
contracts/lib/openzeppelin-contracts/
lib/openzeppelin-contracts/

# === HARDENING (2026-10-19): live-written / runtime artifacts — never commit ===
# Local SQLite database is written continuously by the engine + keeper
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
# Sandbox runtime artifacts
.zscripts/dev.pid
dev.log
# Tool output cache (transient)
tool-results/

